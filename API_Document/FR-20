openapi: 3.0.1

info:
  title: Thông tin tài xế
  description: OpenAPI Spec cho Yêu cầu Chức năng FR20 - Thông tin tài xế
  version: 1.0.0

servers:
  - url: https://api.ridehailing.example.com/v1
    description: Primary API Server

paths:

  /bookings/driver-info:
    post:
      tags:
        - 7.4 Tìm kiếm và phân công tài xế

      summary: FR20 - Hiển thị thông tin tài xế và phương tiện

      description: >
        Hệ thống hiển thị thông tin tài xế và phương tiện cho khách hàng
        sau khi tài xế đã nhận chuyến.

      operationId: FR20_GetDriverInfo

      security:
        - bearerAuth: []

      requestBody:
        required: true

        content:
          application/json:
            example:
              bookingId: "BK202609070001"
              customerId: "CUS1001"

      responses:

        '200':
          description: Lấy thông tin tài xế và phương tiện thành công

          content:
            application/json:
              example:
                success: true
                statusCode: 200
                message: "Lấy thông tin tài xế thành công"
                data:
                  bookingId: "BK202609070001"
                  tripCode: "TRIP202609070001"
                  bookingStatus: "DRIVER_ASSIGNED"
                  driver:
                    driverId: "DRV1001"
                    fullName: "Nguyễn Văn An"
                    phone: "0901234567"
                    avatarUrl: "https://example.com/avatars/DRV1001.jpg"
                    rating: 4.9
                    completedTrips: 1250
                  vehicle:
                    vehicleId: "VH1001"
                    vehicleType: "CAR"
                    brand: "Toyota"
                    model: "Vios"
                    color: "White"
                    licensePlate: "51A-123.45"

        '400':
          description: Thông tin yêu cầu không hợp lệ

          content:
            application/json:
              example:
                success: false
                statusCode: 400
                errorCode: "INVALID_REQUEST"
                message: "Thông tin yêu cầu không hợp lệ"

        '401':
          description: Người dùng chưa đăng nhập hoặc Access Token không hợp lệ

          content:
            application/json:
              example:
                success: false
                statusCode: 401
                errorCode: "UNAUTHORIZED"
                message: "Phiên đăng nhập không hợp lệ hoặc đã hết hạn"

        '403':
          description: Người dùng không có quyền xem thông tin tài xế

          content:
            application/json:
              example:
                success: false
                statusCode: 403
                errorCode: "FORBIDDEN"
                message: "Bạn không có quyền xem thông tin tài xế của chuyến này"

        '404':
          description: Không tìm thấy chuyến hoặc tài xế

          content:
            application/json:
              example:
                success: false
                statusCode: 404
                errorCode: "DRIVER_INFO_NOT_FOUND"
                message: "Không tìm thấy thông tin tài xế hoặc phương tiện"

        '409':
          description: Chuyến chưa được tài xế nhận

          content:
            application/json:
              example:
                success: false
                statusCode: 409
                errorCode: "DRIVER_NOT_ASSIGNED"
                message: "Chuyến chưa được tài xế nhận nên chưa có thông tin tài xế"

        '500':
          description: Lỗi hệ thống máy chủ

          content:
            application/json:
              example:
                success: false
                statusCode: 500
                errorCode: "INTERNAL_SERVER_ERROR"
                message: "Đã xảy ra lỗi trong quá trình xử lý. Vui lòng thử lại sau"

components:

  securitySchemes:

    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: Access Token của người dùng sau khi đăng nhập
