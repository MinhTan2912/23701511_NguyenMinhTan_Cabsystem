openapi: 3.0.1

info:
  title: API Đánh giá tài xế
  description: OpenAPI Spec cho Yêu cầu Chức năng FR42 (BR44 – Đánh giá tài xế)
  version: 1.0.0

servers:
  - url: https://api.ridehailing.example.com/v1
    description: Primary API Server

tags:
  - name: 7.9 Đánh giá và phản hồi
    description: Quản lý đánh giá tài xế sau chuyến đi

paths:

  /ratings/driver:
    post:
      tags:
        - 7.9 Đánh giá và phản hồi
      summary: FR42 – Đánh giá tài xế
      description: Khách hàng có thể đánh giá tài xế bằng số sao sau khi chuyến đi hoàn thành.
      operationId: FR42_rateDriver

      security:
        - bearerAuth: []

      requestBody:
        required: true
        content:
          application/json:
            example:
              tripId: "TRIP202609080001"
              bookingId: "BK202609080001"
              customerId: "CUS001"
              driverId: "DRV001"
              rating: 5
              comment: "Tài xế thân thiện và lái xe an toàn."
              ratedAt: "2026-09-08T15:40:00Z"

      responses:
        '201':
          description: Đánh giá tài xế thành công
          content:
            application/json:
              example:
                success: true
                statusCode: 201
                message: "Driver rating submitted successfully"
                data:
                  ratingId: "RATE202609080001"
                  tripId: "TRIP202609080001"
                  bookingId: "BK202609080001"
                  customerId: "CUS001"
                  driverId: "DRV001"
                  rating: 5
                  comment: "Tài xế thân thiện và lái xe an toàn."
                  ratedAt: "2026-09-08T15:40:00Z"

        '400':
          description: Số sao hoặc thông tin đánh giá không hợp lệ
          content:
            application/json:
              example:
                success: false
                statusCode: 400
                message: "Invalid rating data"
                errorCode: "INVALID_RATING"

        '401':
          description: Chưa xác thực
          content:
            application/json:
              example:
                success: false
                statusCode: 401
                message: "Authentication required"
                errorCode: "UNAUTHORIZED"

        '403':
          description: Khách hàng không có quyền đánh giá chuyến đi
          content:
            application/json:
              example:
                success: false
                statusCode: 403
                message: "You are not allowed to rate this trip"
                errorCode: "FORBIDDEN"

        '404':
          description: Không tìm thấy chuyến đi hoặc tài xế
          content:
            application/json:
              example:
                success: false
                statusCode: 404
                message: "Trip or driver not found"
                errorCode: "RESOURCE_NOT_FOUND"

        '409':
          description: Chuyến đi chưa hoàn thành hoặc khách hàng đã đánh giá
          content:
            application/json:
              example:
                success: false
                statusCode: 409
                message: "Trip is not completed or rating already exists"
                errorCode: "RATING_NOT_ALLOWED"

        '500':
          description: Lỗi hệ thống
          content:
            application/json:
              example:
                success: false
                statusCode: 500
                message: "Internal server error"
                errorCode: "INTERNAL_SERVER_ERROR"


  /ratings/driver/detail:
    post:
      tags:
        - 7.9 Đánh giá và phản hồi
      summary: FR42 – Xem đánh giá tài xế
      description: Hệ thống cung cấp thông tin đánh giá mà khách hàng đã gửi cho tài xế.
      operationId: FR42_getDriverRating

      security:
        - bearerAuth: []

      requestBody:
        required: true
        content:
          application/json:
            example:
              tripId: "TRIP202609080001"
              customerId: "CUS001"

      responses:
        '200':
          description: Lấy đánh giá thành công
          content:
            application/json:
              example:
                success: true
                statusCode: 200
                message: "Driver rating retrieved successfully"
                data:
                  ratingId: "RATE202609080001"
                  tripId: "TRIP202609080001"
                  bookingId: "BK202609080001"
                  customerId: "CUS001"
                  driverId: "DRV001"
                  rating: 5
                  comment: "Tài xế thân thiện và lái xe an toàn."
                  ratedAt: "2026-09-08T15:40:00Z"

        '400':
          description: Thông tin yêu cầu không hợp lệ
          content:
            application/json:
              example:
                success: false
                statusCode: 400
                message: "Invalid rating request"
                errorCode: "INVALID_REQUEST"

        '401':
          description: Chưa xác thực
          content:
            application/json:
              example:
                success: false
                statusCode: 401
                message: "Authentication required"
                errorCode: "UNAUTHORIZED"

        '403':
          description: Không có quyền xem đánh giá
          content:
            application/json:
              example:
                success: false
                statusCode: 403
                message: "Permission denied"
                errorCode: "FORBIDDEN"

        '404':
          description: Không tìm thấy đánh giá
          content:
            application/json:
              example:
                success: false
                statusCode: 404
                message: "Rating not found"
                errorCode: "RATING_NOT_FOUND"

        '500':
          description: Lỗi hệ thống
          content:
            application/json:
              example:
                success: false
                statusCode: 500
                message: "Internal server error"
                errorCode: "INTERNAL_SERVER_ERROR"


components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
