openapi: 3.0.1

info:
  title: API Nhận xét
  description: OpenAPI Spec cho Yêu cầu Chức năng FR43 (BR45 – Nhận xét)
  version: 1.0.0

servers:
  - url: https://api.ridehailing.example.com/v1
    description: Primary API Server

tags:
  - name: 7.9 Đánh giá và phản hồi
    description: Quản lý nhận xét của khách hàng về tài xế và chuyến đi

paths:

  /ratings/comments:
    post:
      tags:
        - 7.9 Đánh giá và phản hồi
      summary: FR43 – Gửi nhận xét
      description: Khách hàng có thể nhập nhận xét về tài xế hoặc chuyến đi sau khi chuyến đi hoàn thành.
      operationId: FR43_submitComment

      security:
        - bearerAuth: []

      requestBody:
        required: true
        content:
          application/json:
            example:
              tripId: "TRIP202609080001"
              bookingId: "BK202609080001"
              customerId: "CUS001"
              driverId: "DRV001"
              commentTarget: "DRIVER"
              comment: "Tài xế thân thiện, phục vụ tốt và lái xe an toàn."
              createdAt: "2026-09-08T15:45:00Z"

      responses:
        '201':
          description: Gửi nhận xét thành công
          content:
            application/json:
              example:
                success: true
                statusCode: 201
                message: "Comment submitted successfully"
                data:
                  commentId: "COM202609080001"
                  tripId: "TRIP202609080001"
                  bookingId: "BK202609080001"
                  customerId: "CUS001"
                  driverId: "DRV001"
                  commentTarget: "DRIVER"
                  comment: "Tài xế thân thiện, phục vụ tốt và lái xe an toàn."
                  createdAt: "2026-09-08T15:45:00Z"

        '400':
          description: Nội dung nhận xét không hợp lệ
          content:
            application/json:
              example:
                success: false
                statusCode: 400
                message: "Invalid comment content"
                errorCode: "INVALID_COMMENT"

        '401':
          description: Chưa xác thực
          content:
            application/json:
              example:
                success: false
                statusCode: 401
                message: "Authentication required"
                errorCode: "UNAUTHORIZED"

        '403':
          description: Khách hàng không có quyền nhận xét chuyến đi
          content:
            application/json:
              example:
                success: false
                statusCode: 403
                message: "You are not allowed to comment on this trip"
                errorCode: "FORBIDDEN"

        '404':
          description: Không tìm thấy chuyến đi hoặc tài xế
          content:
            application/json:
              example:
                success: false
                statusCode: 404
                message: "Trip or driver not found"
                errorCode: "RESOURCE_NOT_FOUND"

        '409':
          description: Chuyến đi chưa hoàn thành hoặc nhận xét đã tồn tại
          content:
            application/json:
              example:
                success: false
                statusCode: 409
                message: "Trip is not completed or comment already exists"
                errorCode: "COMMENT_NOT_ALLOWED"

        '500':
          description: Lỗi hệ thống
          content:
            application/json:
              example:
                success: false
                statusCode: 500
                message: "Internal server error"
                errorCode: "INTERNAL_SERVER_ERROR"


  /ratings/comments/detail:
    post:
      tags:
        - 7.9 Đánh giá và phản hồi
      summary: FR43 – Xem nhận xét
      description: Hệ thống cung cấp nhận xét mà khách hàng đã nhập cho tài xế hoặc chuyến đi.
      operationId: FR43_getComment

      security:
        - bearerAuth: []

      requestBody:
        required: true
        content:
          application/json:
            example:
              commentId: "COM202609080001"
              customerId: "CUS001"

      responses:
        '200':
          description: Lấy nhận xét thành công
          content:
            application/json:
              example:
                success: true
                statusCode: 200
                message: "Comment retrieved successfully"
                data:
                  commentId: "COM202609080001"
                  tripId: "TRIP202609080001"
                  bookingId: "BK202609080001"
                  customerId: "CUS001"
                  driverId: "DRV001"
                  commentTarget: "DRIVER"
                  comment: "Tài xế thân thiện, phục vụ tốt và lái xe an toàn."
                  createdAt: "2026-09-08T15:45:00Z"

        '400':
          description: Thông tin yêu cầu không hợp lệ
          content:
            application/json:
              example:
                success: false
                statusCode: 400
                message: "Invalid comment request"
                errorCode: "INVALID_REQUEST"

        '401':
          description: Chưa xác thực
          content:
            application/json:
              example:
                success: false
                statusCode: 401
                message: "Authentication required"
                errorCode: "UNAUTHORIZED"

        '403':
          description: Không có quyền xem nhận xét
          content:
            application/json:
              example:
                success: false
                statusCode: 403
                message: "Permission denied"
                errorCode: "FORBIDDEN"

        '404':
          description: Không tìm thấy nhận xét
          content:
            application/json:
              example:
                success: false
                statusCode: 404
                message: "Comment not found"
                errorCode: "COMMENT_NOT_FOUND"

        '500':
          description: Lỗi hệ thống
          content:
            application/json:
              example:
                success: false
                statusCode: 500
                message: "Internal server error"
                errorCode: "INTERNAL_SERVER_ERROR"


components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
