openapi: 3.0.1

info:
  title: API Đăng nhập tài khoản
  description: OpenAPI Spec cho Use Case UC02 (Đăng nhập tài khoản)
  version: 1.0.0

servers:
  - url: https://api.ridehailing.example.com/v1
    description: Primary API Server

paths:
  /auth/login:
    post:
      tags:
        - 7.1 Quản lý tài khoản

      summary: UC02 – Đăng nhập

      description: >
        Hệ thống cho phép người dùng đăng nhập bằng số điện thoại và mật khẩu.
        Hệ thống kiểm tra thông tin xác thực và trả về Access Token
        nếu thông tin đăng nhập hợp lệ.

      operationId: UC02_Login

      requestBody:
        required: true

        content:
          application/json:
            schema:
              type: object

              required:
                - phone
                - password

              properties:
                phone:
                  type: string
                  description: Số điện thoại đăng nhập
                  example: "0901234567"

                password:
                  type: string
                  format: password
                  description: Mật khẩu đăng nhập
                  example: "Password123!"

      responses:

        '200':
          description: Đăng nhập thành công

          content:
            application/json:
              schema:
                type: object

                properties:
                  success:
                    type: boolean
                    example: true

                  statusCode:
                    type: integer
                    example: 200

                  message:
                    type: string
                    example: "Đăng nhập thành công"

                  data:
                    type: object

                    properties:
                      accessToken:
                        type: string
                        description: Access Token dùng để xác thực các yêu cầu tiếp theo
                        example: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

                      tokenType:
                        type: string
                        example: "Bearer"

                      expiresIn:
                        type: integer
                        description: Thời gian hết hạn của Access Token tính bằng giây
                        example: 86400

                      userInfo:
                        type: object

                        properties:
                          userId:
                            type: string
                            example: "usr_1001"

                          phone:
                            type: string
                            example: "0901234567"

                          fullName:
                            type: string
                            example: "Nguyen Van A"

                          role:
                            type: string
                            example: "CUSTOMER"

        '400':
          description: Dữ liệu đăng nhập không đúng định dạng hoặc thiếu trường bắt buộc

          content:
            application/json:
              schema:
                type: object

                properties:
                  success:
                    type: boolean
                    example: false

                  statusCode:
                    type: integer
                    example: 400

                  errorCode:
                    type: string
                    example: "INVALID_INPUT_DATA"

                  message:
                    type: string
                    example: "Vui lòng nhập đầy đủ Số điện thoại và Mật khẩu"

        '401':
          description: Đăng nhập thất bại do sai thông tin xác thực

          content:
            application/json:
              schema:
                type: object

                properties:
                  success:
                    type: boolean
                    example: false

                  statusCode:
                    type: integer
                    example: 401

                  errorCode:
                    type: string
                    example: "INVALID_CREDENTIALS"

                  message:
                    type: string
                    example: "Số điện thoại hoặc mật khẩu không chính xác"

        '500':
          description: Lỗi hệ thống máy chủ

          content:
            application/json:
              schema:
                type: object

                properties:
                  success:
                    type: boolean
                    example: false

                  statusCode:
                    type: integer
                    example: 500

                  errorCode:
                    type: string
                    example: "INTERNAL_SERVER_ERROR"

                  message:
                    type: string
                    example: "Đã xảy ra lỗi trong quá trình xử lý. Vui lòng thử lại sau."
